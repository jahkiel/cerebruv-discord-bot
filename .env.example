# ---------------------------------------------------------------------------
# Heroes International bot — copy this file to `.env` and fill it in.
# `.env` is gitignored. Never commit real values.
#
# Every variable below is actually read by src/config.js. If you add one there,
# add it here too.
# ---------------------------------------------------------------------------

# REQUIRED. Discord Developer Portal -> your application -> Bot -> Reset Token.
# Shown only once; if you lose it, reset and paste the new one.
DISCORD_TOKEN=

# REQUIRED. Developer Portal -> General Information -> Application ID.
DISCORD_CLIENT_ID=

# REQUIRED for `npm run deploy` (server-scoped commands appear instantly).
# Your Discord server's ID: enable Developer Mode in Discord
# (Settings -> Advanced), then right-click the server icon -> Copy Server ID.
DEV_SERVER_ID=

# Discord user IDs with superadmin rights, comma-separated.
# Superadmin can read across servers and hard-delete data. Deliberately not a
# role, because it has to work in every server the bot joins.
# Right-click your own name -> Copy User ID.
SUPERADMIN_IDS=

# Where the SQLite file lives, relative to the project root.
DATABASE_PATH=./data/bot.db

# Register commands globally instead of to DEV_SERVER_ID.
# Global registration can take up to an hour to propagate, so the default is
# server-scoped. Only set this to true once the bot serves multiple servers.
REGISTER_GLOBAL=false
